{
 "_comment": "新闻打标签分类体系（harness 固定清单）。categories 按 priority 从高到低排列；维度均为单选；模型只能从枚举取值。",
 "version": 1,
 "promptVersion": 2,
 "priority": ["financing", "release", "bigtech", "paper", "interview", "general"],
 "fallbackCategoryId": "general",
 "model": {
  "api_key_env": "DEEPSEEK_API_KEY",
  "api_base_env": "LLM_API_BASE",
  "default_base": "https://api.deepseek.com",
  "model": "deepseek-v4-flash",
  "temperature": 0,
  "max_output_tokens": 1024,
  "timeout_seconds": 20,
  "concurrency": 8,
  "budget_seconds": 120
 },
 "enrich": {
  "_comment": "正文加工（摘要+分类+标签一次调用）独立预算；长正文单次耗时远高于 800 字符轻调用，不得沿用 model.budget_seconds。",
  "content_input_chars": 16000,
  "summary_min_chars": 100,
  "summary_max_chars": 220,
  "timeout_seconds": 90,
  "concurrency": 3,
  "budget_seconds": 900
 },
 "companyOverview": {
  "_comment": "全类别公司/产品库抽取预算。成功结果永久复用；每轮最多新增 20 篇模型调用，超出部分留到下轮。",
  "content_input_chars": 8000,
  "timeout_seconds": 90,
  "concurrency": 2,
  "budget_seconds": 300,
  "max_new_articles_per_run": 20
 },
 "funding": {
  "_comment": "融资动态表格（scripts/funding_table.py）抽取与搜索补全预算；search 为 Tavily 配置，缺 TAVILY_API_KEY 时自动跳过搜索。",
  "content_input_chars": 16000,
  "timeout_seconds": 90,
  "concurrency": 3,
  "budget_seconds": 600,
  "search": {
   "provider": "tavily",
   "api_key_env": "TAVILY_API_KEY",
   "max_results": 5,
   "cache_ttl_days": 7
  },
  "industry_dim": {
   "label": "所属行业",
   "values": [
    { "id": "game", "label": "AI游戏" },
    { "id": "social", "label": "AI社交/陪伴" },
    { "id": "interactive", "label": "AI互动内容/娱乐" },
    { "id": "creation_tool", "label": "AI创作工具/生产力" },
    { "id": "model_infra", "label": "AI模型/基础设施" },
    { "id": "embodied", "label": "具身智能/机器人" },
    { "id": "other", "label": "其他" }
   ],
   "fallbackValueId": "other"
  },
  "company_type_dim": {
   "label": "公司类型",
   "values": [
    { "id": "startup", "label": "初创公司" },
    { "id": "big_corp", "label": "大厂/已上市" },
    { "id": "other", "label": "其他" }
   ],
   "fallbackValueId": "other"
  }
 },
