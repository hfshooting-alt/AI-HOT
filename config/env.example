# 新闻Daily 网站直采 + 并行科技模型配置（复制为 .env 本地使用）
# 真实 .env 已被 .gitignore 忽略，本文件不含任何真实密钥。
# 当前默认 direct-only；full 也是直采别名；定时关闭。
# config/services.json 禁止真实 Manus/Tavily 请求，不需要配置这两类密钥。

# ---- 正文筛选、摘要分类、公司/融资抽取及已知网页补全 ----
PARATERA_API_KEY=your-paratera-api-key
LLM_API_BASE=https://llmapi.paratera.com/v1
LLM_MODEL=DeepSeek-V4-Pro
# 本地旧 DEEPSEEK_API_KEY 可承载同一并行科技密钥，作为兼容别名。
# 并行科技域名同时有两者时优先 PARATERA_API_KEY；不是另一个提供商回退。
# DEEPSEEK_API_KEY=your-paratera-api-key
# GitHub 工作流只读 Secret PARATERA_API_KEY，固定上述 base/model，不使用变量回退。

# 每次扫描只固定一次北京时间截止时刻；留空由统一入口取启动时刻，恢复沿原值。
# NEWS_COLLECTION_END=2026-09-23T14:00:00+08:00

# ---- 资料补全边界 ----
# 直采 overview 显式 --research-full-review：取消每日5主体/10页/5请求上限。
# 有限已知网页队列，每主体最多2页，每输入1次新模型请求；不搜索新链接。
# 成功缓存、请求前账本、失败不自动重试及异常熔断保持。
# 云端同日运行归属/恢复门禁仍保留；默认小样本及历史恢复保持原语义。

# ---- 旧独立正文脚本兼容参数（非当前直采入口，不启用 Manus）----
# 变量名沿用历史；旧原始输入回放仍保留其原配置，不改写旧状态。
# MANUS_CONTENT_MODE=script
# MANUS_CRAWL_TIMEOUT_SECONDS=20
# MANUS_CRAWL_RETRIES=2
# MANUS_CRAWL_CONCURRENCY=4
# MANUS_CRAWL_REQUEST_DELAY_SECONDS=1.0
# MANUS_MAX_CONTENT_CHARS=20000
# MANUS_MIN_CONTENT_CHARS=100

# ---- 本地设置页（可选）----
# Next.js 设置页「保存到本地」调用本服务写 .env（scripts/settings-server.mjs）。
# AIHOT_SETTINGS_PORT=9731
